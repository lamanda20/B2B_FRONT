<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.b2bfront.controller.LivraisonController"
      alignment="TOP_CENTER" spacing="15" styleClass="root">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <HBox alignment="CENTER" spacing="10" styleClass="breadcrumb">
        <Label text="Address" styleClass="breadcrumb-active"/>
        <Label text=">" styleClass="breadcrumb-separator"/>
        <Label text="Shipping" styleClass="breadcrumb-inactive"/>
        <Label text=">" styleClass="breadcrumb-separator"/>
        <Label text="Payment" styleClass="breadcrumb-inactive"/>
    </HBox>

    <Label text="Shipping Information" styleClass="header-title" alignment="CENTER_LEFT">
        <VBox.margin>
            <Insets top="20" bottom="5"/>
        </VBox.margin>
    </Label>

    <TextField fx:id="adresseField" promptText="Adresse"/>
    <TextField fx:id="villeField" promptText="Ville"/>

    <HBox spacing="10">
        <TextField fx:id="codePostalField" promptText="Code Postal" HBox.hgrow="ALWAYS"/>
        <TextField fx:id="telephoneField" promptText="Téléphone" HBox.hgrow="ALWAYS"/>
    </HBox>

    <Button fx:id="calculateButton" text="Calculer les frais de livraison"
            onAction="#onCalculateFraisClick" maxWidth="Infinity" styleClass="button-calculate"/>

    <Button fx:id="saveButton" text="Enregistrer et continuer"
            onAction="#onSaveClick" maxWidth="Infinity" styleClass="button-save" disable="true"/>

    <Label fx:id="statusLabel" styleClass="status-label" wrapText="true"/>

</VBox>