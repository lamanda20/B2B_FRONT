<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.b2bfront.controller.ShippingController"
      alignment="TOP_CENTER" spacing="15" styleClass="root">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30" />
    </padding>

    <HBox alignment="CENTER" spacing="10" styleClass="breadcrumb">
        <Label text="Address" styleClass="breadcrumb-inactive" />
        <Label text=">" styleClass="breadcrumb-separator" />
        <Label text="Shipping" styleClass="breadcrumb-active" />
        <Label text=">" styleClass="breadcrumb-separator" />
        <Label text="Payment" styleClass="breadcrumb-inactive" />
    </HBox>

    <Label text="Shipping Method" styleClass="header-title" alignment="CENTER_LEFT">
        <VBox.margin>
            <Insets top="20" bottom="5" />
        </VBox.margin>
    </Label>

    <VBox spacing="10" style="-fx-border-color: #eee; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 15;">
        <fx:define>
            <ToggleGroup fx:id="transporteurGroup" />
        </fx:define>
        <RadioButton text="Maroc Poste (Standard - 3 jours)" toggleGroup="$transporteurGroup"
                     userData="Maroc Poste" selected="true" />
        <RadioButton text="Amana Express (Express - 1 jour)" toggleGroup="$transporteurGroup"
                     userData="Amana Express" />
        <RadioButton text="DHL (International)" toggleGroup="$transporteurGroup"
                     userData="DHL" />
    </VBox>

    <Button fx:id="paymentButton" text="Continuer vers le Paiement"
            onAction="#onContinueToPaymentClick" maxWidth="Infinity" styleClass="button-save" />

    <Label fx:id="statusLabel" styleClass="status-label" wrapText="true" />

</VBox>