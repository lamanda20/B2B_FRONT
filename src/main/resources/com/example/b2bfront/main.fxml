<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.b2bfront.controller.MainController"
            prefHeight="800.0" prefWidth="1400.0">

    <!-- Top Navigation Bar -->
    <top>
        <VBox style="-fx-background-color: #2c3e50;">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 15;">
                <Label text="🛒 Plateforme B2B" textFill="white">
                    <font>
                        <Font name="System Bold" size="24.0"/>
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" text="Backend: http://localhost:8082/api"
                       textFill="#ecf0f1" style="-fx-font-size: 12;"/>
            </HBox>

            <!-- Menu Bar -->
            <HBox spacing="5" style="-fx-background-color: #34495e; -fx-padding: 10;">
                <Button text="🏠 Accueil" onAction="#onShowHome"
                        styleClass="menu-button" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 14;"/>
                <Button text="📦 Produits" onAction="#onShowProducts"
                        styleClass="menu-button" style="-fx-background-color: #16a085; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 14;"/>
                <Button text="🛒 Panier" onAction="#onShowCart"
                        styleClass="menu-button" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 14;"/>
                <Button text="📋 Commandes" onAction="#onShowOrders"
                        styleClass="menu-button" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 14;"/>
                <Button text="💳 Paiements" onAction="#onShowPayments"
                        styleClass="menu-button" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 14;"/>
                <Button text="🚚 Livraisons" onAction="#onShowDelivery"
                        styleClass="menu-button" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 14; -fx-font-weight: bold;"/>
                <Button text="🔔 Notifications" onAction="#onShowNotifications"
                        styleClass="menu-button" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-padding: 10 20; -fx-font-size: 14;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Main Content Area - C'est ici que les modules seront chargés -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #ecf0f1;">
            <!-- Vue par défaut - Page d'accueil -->
            <VBox alignment="CENTER" spacing="30" style="-fx-padding: 50;">
                <Label text="🏠 Bienvenue sur la Plateforme B2B" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <GridPane hgap="20" vgap="20" alignment="CENTER">
                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="📦" style="-fx-font-size: 48;"/>
                        <Label text="Produits" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                        <Label text="Gérer le catalogue" style="-fx-font-size: 12; -fx-text-fill: gray;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="🛒" style="-fx-font-size: 48;"/>
                        <Label text="Panier" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                        <Label text="Gérer vos achats" style="-fx-font-size: 12; -fx-text-fill: gray;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="📋" style="-fx-font-size: 48;"/>
                        <Label text="Commandes" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                        <Label text="Suivre vos commandes" style="-fx-font-size: 12; -fx-text-fill: gray;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="💳" style="-fx-font-size: 48;"/>
                        <Label text="Paiements" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                        <Label text="Gérer les paiements" style="-fx-font-size: 12; -fx-text-fill: gray;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20; -fx-background-color: #9b59b6; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 3);" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="🚚" style="-fx-font-size: 48;"/>
                        <Label text="Livraisons" textFill="white" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                        <Label text="✅ Module Actif" textFill="#ecf0f1" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <Label text="🔔" style="-fx-font-size: 48;"/>
                        <Label text="Notifications" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                        <Label text="Alertes et messages" style="-fx-font-size: 12; -fx-text-fill: gray;"/>
                    </VBox>
                </GridPane>

                <VBox alignment="CENTER" spacing="10" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 10; -fx-max-width: 600;">
                    <Label text="💡 Instructions pour l'équipe" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
                    <Label text="Cliquez sur 'Livraisons' pour voir le module actif" style="-fx-font-size: 12;"/>
                    <Label text="Les autres modules peuvent être intégrés en appelant la méthode loadModule() dans MainController"
                           wrapText="true" style="-fx-font-size: 11; -fx-text-fill: gray; -fx-text-alignment: center;"/>
                </VBox>
            </VBox>
        </StackPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #34495e; -fx-padding: 15;">
            <Label text="Backend: " textFill="#95a5a6" style="-fx-font-size: 11;"/>
            <Label fx:id="backendStatusLabel" text="✅ Connecté à http://localhost:8082/api"
                   textFill="#2ecc71" style="-fx-font-size: 11; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Plateforme B2B v1.0 | Module Livraison: ✅ Actif"
                   textFill="#95a5a6" style="-fx-font-size: 10;"/>
        </HBox>
    </bottom>

</BorderPane>
